# Rubityle Configuration
DAEMON_PORT=8080
DAEMON_TOKEN=change-me-daemon-token
PANEL_URL=http://your-panel-url:7956
PANEL_API_KEY=
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=pylox-servers
DATA_DIR=/var/lib/rubityle
LOG_DIR=/var/log/rubityle
SFTP_PORT=2022
# Owner applied to server files after root-run install containers finish.
SERVER_UID=1001
SERVER_GID=1001
# A server that sits at/above a RAM/CPU/DISK limit for this many seconds is killed.
RESOURCE_LIMIT_GRACE_SECONDS=600
# How often (seconds) running servers are checked against their limits.
RESOURCE_MONITOR_INTERVAL_SECONDS=15
# How long a server may report "starting" before it is flipped to "running"
# even when the egg never prints its startup-done line.
STARTUP_TIMEOUT_SECONDS=180
# How long an egg stop command gets to shut the server down before the
# daemon falls back to a Docker stop.
STOP_GRACE_SECONDS=10
# Docker stop timeout (SIGTERM grace) before the container is killed.
STOP_TIMEOUT_SECONDS=20
